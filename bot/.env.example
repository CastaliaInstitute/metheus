# Matrix bot account: create the account and invite it only to approved private rooms.
MATRIX_HOMESERVER_URL=https://matrix.example.org
MATRIX_BOT_ACCESS_TOKEN=replace-with-bot-account-access-token
MATRIX_ALLOWED_ROOM_IDS=!replace:example.org

# Model requests run server-side; set this key only in the deployment secret store.
OPENAI_API_KEY=replace-with-openai-api-key
OPENAI_MODEL=replace-with-an-enabled-model
# Optional OpenAI-compatible endpoint. For a local Ollama service:
# OPENAI_API_KEY=ollama
# OPENAI_BASE_URL=http://host.docker.internal:11434/v1
# OPENAI_MODEL=qwen3:8b

# Optional path to the source-attributed gate-correspondence catalog.
# The default resolves to ../catalog/gate-endocrine-correspondences.json in this repository.
# METHEUS_CORRESPONDENCE_CATALOG=../catalog/gate-endocrine-correspondences.json
# METHEUS_TOPOLOGY_CATALOG=../catalog/human-design-bodygraph-topology.json
# METHEUS_GATE_AI_AFFORDANCE_CATALOG=../catalog/gate-ai-affordances.json

# Keep this directory on a private persistent volume with restricted host access.
METHEUS_BOT_DATA_DIR=./data
