{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://metheus.castalia.institute/schema/assembled-reading.schema.json",
  "title": "Metheus assembled reading package",
  "description": "Validated deterministic presentation package. Validation checks structure and provenance links, not whether authored text is entailed by sources.",
  "type": "object",
  "additionalProperties": false,
  "required": ["assembled", "readingId", "subjectId", "version", "purpose", "question", "timeWindow", "claims", "limitations", "assembly"],
  "properties": {
    "assembled": { "const": true },
    "readingId": { "type": "string", "minLength": 1 },
    "subjectId": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1 },
    "purpose": { "enum": ["symbolic_calculation", "personal_reflection", "rhythm_summary", "learning_support", "health_record_organization", "caregiver_coordination", "clinical_sharing", "other"] },
    "question": { "type": "string", "minLength": 1 },
    "timeWindow": { "$ref": "#/$defs/timeWindow" },
    "reflectionOptions": {
      "type": "array",
      "items": { "$ref": "#/$defs/reflectionOption" },
      "description": "Optional authored prompts and supports preserved with provenance and subject status; not verified recommendations."
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["position", "claimType", "text", "sourceIds", "sources", "phaseAnnotations", "references", "support"],
        "properties": {
          "position": { "type": "integer", "minimum": 1 },
          "claimType": { "enum": ["observation", "estimate", "symbolic_prompt", "interpretive_question", "hypothesis", "boundary"] },
          "text": { "type": "string", "minLength": 1, "description": "One substantive sentence or atomic statement, preserving the source links for this claim only." },
          "sourceIds": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
          "sources": { "type": "array", "items": { "$ref": "#/$defs/source" } },
          "phaseAnnotations": { "type": "array", "items": { "$ref": "#/$defs/phaseAnnotation" } },
          "references": { "type": "array", "items": { "$ref": "#/$defs/reference" } },
          "support": { "$ref": "#/$defs/support" }
        }
      }
    },
    "limitations": { "type": "array", "items": { "type": "string" } },
    "assembly": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "sourceTextGenerated", "textEntailmentVerified", "inputSchemasValidated", "outputSchemaValidated", "authorizedAction"],
      "properties": {
        "kind": { "const": "deterministic_claim_assembly" },
        "sourceTextGenerated": { "const": false },
        "textEntailmentVerified": { "const": false },
        "inputSchemasValidated": { "const": true },
        "outputSchemaValidated": { "const": true },
        "authorizedAction": { "enum": ["analyze", "remote_processing"] },
        "provenanceAudit": {
          "type": "object",
          "additionalProperties": false,
          "required": ["method", "claimCount", "claimsWithSourceRecords", "claimsWithPhaseAnnotations", "claimsWithKnowledgeReferences", "claimsWithAtLeastOneResolvedLink", "unlinkedClaimPositions", "textEntailmentAssessed"],
          "properties": {
            "method": { "const": "claim_reference_presence/1.0.0" },
            "claimCount": { "type": "integer", "minimum": 0 },
            "claimsWithSourceRecords": { "type": "integer", "minimum": 0 },
            "claimsWithPhaseAnnotations": { "type": "integer", "minimum": 0 },
            "claimsWithKnowledgeReferences": { "type": "integer", "minimum": 0 },
            "claimsWithAtLeastOneResolvedLink": { "type": "integer", "minimum": 0 },
            "unlinkedClaimPositions": { "type": "array", "uniqueItems": true, "items": { "type": "integer", "minimum": 1 } },
            "textEntailmentAssessed": { "const": false }
          }
        }
      }
    }
  },
  "$defs": {
    "reflectionOption": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "text", "basis", "sourceIds", "sources", "subjectStatus", "limitations"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["learning_approach", "environmental_affordance", "observation_question", "reflection_question", "professional_consultation", "other"] },
        "text": { "type": "string", "minLength": 1 },
        "basis": { "enum": ["learner_goal", "task_demand", "access_need", "developmental_context", "symbolic_prompt", "evidence_reference", "multiple_non_symbolic_inputs", "unspecified"] },
        "sourceIds": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "sources": { "type": "array", "items": { "$ref": "#/$defs/source" } },
        "subjectStatus": { "enum": ["not_reviewed", "chosen", "declined", "revised"] },
        "limitations": { "type": "array", "items": { "type": "string" } },
        "environmentalAffordance": {
          "type": "object",
          "additionalProperties": false,
          "required": ["deliveryMode", "intendedFunction", "roleFrame"],
          "properties": {
            "deliveryMode": { "enum": ["conversational_ai", "human_peer", "human_professional", "group_or_community", "physical_environment", "routine_or_practice", "digital_tool", "sensory_cue", "other"] },
            "intendedFunction": { "enum": ["communication_practice", "reflection", "problem_solving", "learning", "structure_or_routine", "access_support", "sensory_context", "connection", "other"] },
            "roleFrame": { "enum": ["tool_or_scaffold", "human_relationship", "environmental_condition", "other"] },
            "trialWindow": { "type": "string" },
            "userDefinedDescription": { "type": "string" },
            "aiSafeguards": {
              "type": "object",
              "additionalProperties": false,
              "required": ["identityTransparent", "privacyBoundariesDisclosed", "notHumanRelationshipSubstitute"],
              "properties": {
                "identityTransparent": { "const": true },
                "privacyBoundariesDisclosed": { "const": true },
                "notHumanRelationshipSubstitute": { "const": true }
              }
            }
          }
        }
      },
      "allOf": [
        { "$ref": "https://metheus.castalia.institute/schema/phase-annotation.schema.json#/$defs/phaseVocabularyConstraint" },
        {
          "if": { "properties": { "basis": { "const": "clinically_assessed" } }, "required": ["basis"] },
          "then": {
            "required": ["sourceSystem"],
            "properties": { "sourceSystem": { "required": ["name"] } }
          }
        },
        {
          "if": { "required": ["kind"], "properties": { "kind": { "const": "environmental_affordance" } } },
          "then": {
            "required": ["environmentalAffordance"],
            "properties": {
              "basis": { "enum": ["learner_goal", "task_demand", "access_need", "developmental_context", "evidence_reference", "multiple_non_symbolic_inputs"] },
              "sourceIds": { "minItems": 1 }
            }
          }
        },
        {
          "if": { "required": ["environmentalAffordance"] },
          "then": { "properties": { "kind": { "const": "environmental_affordance" } } }
        },
        {
          "if": { "required": ["environmentalAffordance"], "properties": { "environmentalAffordance": { "required": ["deliveryMode"], "properties": { "deliveryMode": { "const": "conversational_ai" } } } } },
          "then": { "properties": { "environmentalAffordance": { "required": ["aiSafeguards"], "properties": { "roleFrame": { "const": "tool_or_scaffold" } } } } }
        }
      ]
    },
    "timeWindow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start", "end", "precision"],
      "properties": {
        "start": { "type": "string", "format": "date-time" },
        "end": { "type": "string", "format": "date-time" },
        "timeZone": { "type": "string" },
        "precision": { "enum": ["exact", "approximate", "date_only"] }
      }
    },
    "support": {
      "type": "object",
      "additionalProperties": false,
      "required": ["confidence", "coverage"],
      "properties": {
        "confidence": { "enum": ["high", "moderate", "low", "not_applicable"] },
        "coverage": { "enum": ["adequate", "partial", "sparse", "unknown"] },
        "rationale": { "type": "string" },
        "alternatives": { "type": "array", "items": { "type": "string" } }
      }
    },
    "source": {
      "type": "object",
      "required": ["id", "recordType"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "recordType": { "type": "string", "minLength": 1 },
        "derivedSummary": { "type": "object" }
      },
      "additionalProperties": true
    },
    "phaseAnnotation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "layer", "phaseSystem", "canonicalPhase", "window", "basis", "interpretation", "basisRecordIds", "method", "uncertainty", "limitations"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "layer": { "enum": ["promethean", "epimethean"] },
        "phaseSystem": { "enum": ["human_design_transit", "astrological_transit", "menstrual_cycle", "pregnancy", "postpartum", "menopause", "development", "sleep_wake", "circadian_rhythm", "eating_rhythm", "ultradian_rhythm", "other"] },
        "canonicalPhase": { "type": "string", "minLength": 1, "description": "Controlled phase label from the versioned phase vocabulary for the selected phaseSystem; phaseSystem=other may use a clearly described user-defined label." },
        "evocativeName": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "window": { "type": "object" },
        "basis": { "enum": ["reported", "observed", "derived", "clinically_assessed"] },
        "interpretation": { "enum": ["descriptive", "symbolic", "reflective"] },
        "sourceSystem": {
          "type": "object",
          "properties": {
            "name": { "type": "string", "minLength": 1 },
            "lineage": { "type": "string" },
            "version": { "type": "string" },
            "citation": { "type": "string", "format": "uri" }
          }
        },
        "nameSource": { "enum": ["metheus_suggestion", "user_authored", "source_attributed"], "description": "Who supplied the optional evocative name; required whenever evocativeName is present." },
        "basisRecordIds": { "type": "array", "items": { "type": "string" } },
        "method": { "type": "string", "minLength": 1 },
        "methodVersion": { "type": "string" },
        "uncertainty": { "type": "string", "minLength": 1 },
        "limitations": { "type": "array", "items": { "type": "string" } },
        "supersedes": { "type": "string", "minLength": 1 }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "phaseSystem": { "const": "menstrual_cycle" },
              "canonicalPhase": {
                "enum": [
                  "follicular_phase_estimate",
                  "later_follicular_estimate",
                  "ovulatory_window_estimate",
                  "luteal_phase_estimate",
                  "late_luteal_estimate"
                ]
              }
            },
            "required": ["phaseSystem", "canonicalPhase"]
          },
          "then": { "properties": { "basis": { "enum": ["derived", "clinically_assessed"] } } }
        },
        {
          "if": {
            "properties": {
              "phaseSystem": { "const": "menopause" },
              "canonicalPhase": { "const": "menopause_milestone" }
            },
            "required": ["phaseSystem", "canonicalPhase"]
          },
          "then": { "properties": { "basis": { "enum": ["derived", "clinically_assessed"] } }
          }
        },
        {
          "if": { "required": ["evocativeName"] },
          "then": { "required": ["nameSource"] }
        },
        {
          "if": { "required": ["nameSource"] },
          "then": { "required": ["evocativeName"] }
        },
        {
          "if": {
            "properties": { "nameSource": { "const": "source_attributed" } },
            "required": ["nameSource"]
          },
          "then": {
            "required": ["sourceSystem"],
            "properties": { "sourceSystem": { "required": ["name", "citation"] } }
          }
        }
      ]
    },
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "sourceCitations", "limitations"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["correspondence", "evidence_claim"] },
        "claimText": { "type": "string", "minLength": 1 },
        "evidenceStatus": { "type": "string" },
        "relationType": { "enum": ["tradition_attributed", "reflective_association", "empirical_association"] },
        "permittedUse": { "enum": ["optional_reflective_prompt", "research_hypothesis", "educational_context"] },
        "sourceSystem": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name"],
          "properties": {
            "name": { "type": "string", "minLength": 1 },
            "lineage": { "type": "string" },
            "version": { "type": "string" }
          }
        },
        "sourceFeature": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "id"],
          "properties": {
            "kind": { "enum": ["center", "gate", "channel", "chakra", "chart_feature", "other"] },
            "id": { "type": "string", "minLength": 1 },
            "label": { "type": "string" },
            "line": { "type": "integer", "minimum": 1, "maximum": 6 }
          }
        },
        "targetConcept": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "id"],
          "properties": {
            "kind": { "enum": ["hormone", "neurochemical", "organ", "physiological_process", "experience", "developmental_context", "other"] },
            "id": { "type": "string", "minLength": 1 },
            "label": { "type": "string" }
          }
        },
        "scope": {
          "type": "object",
          "additionalProperties": false,
          "required": ["description"],
          "properties": {
            "description": { "type": "string", "minLength": 1 },
            "population": { "type": "string" },
            "setting": { "type": "string" },
            "exposureOrSignal": { "type": "string" },
            "routeOrSpecimen": { "type": "string" },
            "comparator": { "type": "string" },
            "outcome": { "type": "string" },
            "timeframe": { "type": "string" }
          }
        },
        "sourceCitations": { "type": "array" },
        "limitations": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
