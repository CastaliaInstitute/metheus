{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://metheus.castalia.institute/schema/consent.schema.json",
  "title": "Metheus scoped consent grant",
  "description": "Draft v0.1 consent and permission record. It does not establish legal authority or legal compliance.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "subjectId", "grantor", "domains", "purposes", "permittedActions", "status", "consentTextVersion", "createdAt"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "subjectId": { "type": "string", "minLength": 1 },
    "grantor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reference", "role"],
      "properties": {
        "reference": { "type": "string", "minLength": 1 },
        "role": { "enum": ["subject", "parent_guardian", "legally_authorized_representative", "authorized_delegate", "unknown"] }
      }
    },
    "domains": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "enum": ["birth_chart_inputs", "biometrics", "reproductive", "intimacy", "clinical_results", "nutrition_behavior", "learning", "child_development", "relationships", "other"] }
    },
    "purposes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "enum": ["symbolic_calculation", "personal_reflection", "rhythm_summary", "learning_support", "health_record_organization", "caregiver_coordination", "clinical_sharing", "other"] }
    },
    "permittedActions": {
      "type": "array",
      "uniqueItems": true,
      "items": { "enum": ["collect", "analyze", "share", "remote_processing"] }
    },
    "recipient": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reference", "role"],
      "properties": {
        "reference": { "type": "string", "minLength": 1 },
        "role": { "enum": ["clinician", "educator", "caregiver", "family_member", "service_provider", "other"] }
      }
    },
    "scopeNote": { "type": "string", "description": "Brief description of selected records/date range or sharing scope; avoid copying sensitive data here." },
    "childParticipation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "assentState": { "enum": ["not_applicable", "not_asked", "asked_agreed", "asked_declined", "not_able_to_express", "unknown"] },
        "ageAppropriateMethod": { "type": "string" },
        "observedAt": { "type": "string", "format": "date-time" }
      }
    },
    "status": { "enum": ["pending", "granted", "denied", "withdrawn", "expired"] },
    "consentTextVersion": { "type": "string", "minLength": 1 },
    "remoteProcessingDisclosureVersion": { "type": "string" },
    "createdAt": { "type": "string", "format": "date-time" },
    "expiresAt": { "type": "string", "format": "date-time" },
    "withdrawnAt": { "type": "string", "format": "date-time" },
    "supersedes": { "type": "string" },
    "revokesGrantIds": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "auditReference": { "type": "string" }
  },
  "allOf": [
    {
      "if": { "required": ["status"], "properties": { "status": { "const": "granted" } } },
      "then": { "properties": { "permittedActions": { "minItems": 1 } } }
    },
    {
      "if": { "required": ["status"], "properties": { "status": { "const": "denied" } } },
      "then": { "properties": { "permittedActions": { "maxItems": 0 } } }
    },
    {
      "if": { "required": ["status"], "properties": { "status": { "const": "pending" } } },
      "then": { "properties": { "permittedActions": { "maxItems": 0 } } }
    },
    {
      "if": { "required": ["status"], "properties": { "status": { "const": "withdrawn" } } },
      "then": { "required": ["withdrawnAt"], "properties": { "permittedActions": { "maxItems": 0 } } }
    },
    {
      "if": { "required": ["status"], "properties": { "status": { "const": "expired" } } },
      "then": { "required": ["expiresAt"], "properties": { "permittedActions": { "maxItems": 0 } } }
    },
    {
      "if": { "required": ["permittedActions"], "properties": { "permittedActions": { "contains": { "const": "share" } } } },
      "then": { "required": ["recipient", "scopeNote"] }
    },
    {
      "if": { "required": ["permittedActions"], "properties": { "permittedActions": { "contains": { "const": "remote_processing" } } } },
      "then": { "required": ["remoteProcessingDisclosureVersion"] }
    }
  ]
}
