{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://metheus.castalia.institute/schema/endocrine-relations-catalog.schema.json",
  "title": "Metheus candidate endocrine relations catalog",
  "description": "A candidate-only container for sourced endocrine pathway relations. Presence does not imply review or individual applicability.",
  "type": "object",
  "additionalProperties": false,
  "required": ["catalogVersion", "catalogStatus", "policy", "relations"],
  "properties": {
    "$schema": { "type": "string", "format": "uri" },
    "catalogVersion": { "type": "string", "minLength": 1 },
    "catalogStatus": { "const": "candidate_only" },
    "policy": { "type": "string", "minLength": 1 },
    "relations": { "type": "array", "minItems": 1, "items": { "type": "object" } }
  }
}
