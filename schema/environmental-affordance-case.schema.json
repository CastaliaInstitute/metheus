{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://metheus.castalia.institute/schema/environmental-affordance-case.schema.json",
  "title": "Metheus environmental-affordance link case",
  "description": "Synthetic input bundle for in-memory affordance option, lifecycle event, and response reference checks. This schema does not resolve cross-record identifiers or authorize records.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "schemaVersion", "dataStatus", "sourceReadings", "records", "selectedRecordIds", "limitations"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "schemaVersion": { "const": "0.1" },
    "dataStatus": { "const": "synthetic_fixture" },
    "sourceReadings": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "https://metheus.castalia.institute/schema/reading.schema.json" }
    },
    "records": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "https://metheus.castalia.institute/schema/observation.schema.json" }
    },
    "selectedRecordIds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "limitations": { "type": "array", "minItems": 1, "items": { "type": "string" } }
  }
}
