{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://metheus.castalia.institute/schema/gate-ai-affordance-catalog.schema.json",
  "title": "Metheus optional AI affordances for Human Design gates",
  "description": "Draft, user-selected AI activity ideas keyed to source-specific symbolic gate titles. These do not define a chart, infer a need, or establish gate activation or biological effects.",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "catalogId", "version", "status", "topologyCatalogId", "topologyVersion", "policy", "entries"],
  "properties": {
    "$schema": { "type": "string" },
    "catalogId": { "const": "metheus-gate-ai-affordances-v1" },
    "version": { "type": "string", "minLength": 1 },
    "status": { "const": "draft_design_proposals" },
    "topologyCatalogId": { "const": "human-design-bodygraph-topology-v1" },
    "topologyVersion": { "type": "string", "minLength": 1 },
    "policy": { "type": "string", "minLength": 1 },
    "entries": {
      "type": "array",
      "minItems": 64,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["gateNumber", "title", "centerId", "channelIds", "aiAffordance", "examplePrompt", "interactionModes"],
        "properties": {
          "gateNumber": { "type": "integer", "minimum": 1, "maximum": 64 },
          "title": { "type": "string", "minLength": 1 },
          "centerId": { "enum": ["head", "ajna", "throat", "g_identity", "heart", "solar_plexus", "sacral", "spleen", "root"] },
          "channelIds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^ch-[0-9]{1,2}-[0-9]{1,2}$" } },
          "aiAffordance": { "type": "string", "minLength": 20 },
          "examplePrompt": { "type": "string", "minLength": 20 },
          "interactionModes": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "enum": ["create", "organize", "compare", "communicate", "reflect", "adapt", "practice", "coordinate", "learn"] }
          }
        }
      }
    }
  }
}
