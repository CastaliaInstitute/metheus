{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://metheus.castalia.institute/schema/human-design-bodygraph-topology.schema.json",
  "title": "Source-attributed Human Design bodygraph topology catalog",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "catalogId",
    "catalogStatus",
    "version",
    "description",
    "sources",
    "topologyProvenance",
    "biologyBoundary",
    "centers",
    "gates",
    "channels"
  ],
  "properties": {
    "catalogId": { "const": "human-design-bodygraph-topology-v1" },
    "catalogStatus": { "const": "source_attributed_symbolism" },
    "version": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "sources": {
      "type": "array",
      "minItems": 2,
      "items": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "url", "retrievedAt", "scope"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "format": "uri" },
        "retrievedAt": { "type": "string", "format": "date" },
        "scope": { "type": "string", "minLength": 1 }
      }
      }
    },
    "topologyProvenance": { "type": "string", "minLength": 1 },
    "biologyBoundary": { "type": "string", "minLength": 1 },
    "centers": {
      "type": "array",
      "minItems": 9,
      "maxItems": 9,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "gateNumbers"],
        "properties": {
          "id": {
            "enum": ["head", "ajna", "throat", "g_identity", "heart", "solar_plexus", "sacral", "spleen", "root"]
          },
          "name": { "type": "string", "minLength": 1 },
          "gateNumbers": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "integer", "minimum": 1, "maximum": 64 }
          }
        }
      }
    },
    "gates": {
      "type": "array",
      "minItems": 64,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["number", "title", "centerId", "channelIds"],
        "properties": {
          "number": { "type": "integer", "minimum": 1, "maximum": 64 },
          "title": { "type": "string", "minLength": 1 },
          "centerId": {
            "enum": ["head", "ajna", "throat", "g_identity", "heart", "solar_plexus", "sacral", "spleen", "root"]
          },
          "channelIds": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "pattern": "^ch-(?:[1-9]|[1-5][0-9]|6[0-4])-(?:[1-9]|[1-5][0-9]|6[0-4])$" }
          }
        }
      }
    },
    "channels": {
      "type": "array",
      "minItems": 36,
      "maxItems": 36,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "gateA", "gateB", "centerA", "centerB"],
        "properties": {
          "id": { "type": "string", "pattern": "^ch-(?:[1-9]|[1-5][0-9]|6[0-4])-(?:[1-9]|[1-5][0-9]|6[0-4])$" },
          "gateA": { "type": "integer", "minimum": 1, "maximum": 64 },
          "gateB": { "type": "integer", "minimum": 1, "maximum": 64 },
          "centerA": {
            "enum": ["head", "ajna", "throat", "g_identity", "heart", "solar_plexus", "sacral", "spleen", "root"]
          },
          "centerB": {
            "enum": ["head", "ajna", "throat", "g_identity", "heart", "solar_plexus", "sacral", "spleen", "root"]
          }
        }
      }
    }
  }
}
