{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://metheus.castalia.institute/schema/interaction-event.schema.json",
  "title": "Metheus subject-authored interaction record",
  "description": "A privacy-minimized account of an interaction from one subject's perspective. It does not establish another participant's experience, consent, relationship status, or physiology.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "subjectId",
    "recordType",
    "schemaVersion",
    "eventKind",
    "time",
    "source",
    "domain",
    "participantReferences",
    "perspective",
    "limitations"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "supersedes": {
      "type": "string",
      "minLength": 1,
      "description": "ID of the prior same-subject interaction account corrected by this record. The earlier account remains historical and separately consented."
    },
    "subjectId": {
      "type": "string",
      "minLength": 1,
      "description": "Pseudonymous owner and sole recorder of this account."
    },
    "recordType": {
      "const": "interaction_event"
    },
    "schemaVersion": {
      "type": "string",
      "minLength": 1
    },
    "eventKind": {
      "enum": [
        "conversation",
        "caregiving",
        "conflict",
        "repair",
        "affection",
        "intimacy",
        "shared_activity",
        "other"
      ]
    },
    "interactionGroupId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{22,128}$",
      "description": "Optional high-entropy opaque, event-specific token used only when separately authored participant records are intentionally grouped. Generate a fresh random value; never use a person's name, account handle, contact detail, or inferred identity. Sharing this token does not authenticate that the records describe the same event."
    },
    "domain": {
      "enum": [
        "relationship",
        "intimacy"
      ],
      "description": "Must be intimacy for an intimacy event; otherwise relationship. Drives narrow consent checks."
    },
    "time": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "precision"
      ],
      "properties": {
        "start": {
          "type": "string",
          "format": "date-time"
        },
        "end": {
          "type": "string",
          "format": "date-time"
        },
        "observedAt": {
          "type": "string",
          "format": "date-time"
        },
        "date": {
          "type": "string",
          "format": "date"
        },
        "timeZone": {
          "type": "string"
        },
        "precision": {
          "enum": [
            "exact",
            "approximate",
            "date_only",
            "unknown"
          ]
        }
      },
      "anyOf": [
        {
          "required": [
            "observedAt"
          ]
        },
        {
          "required": [
            "start"
          ]
        },
        {
          "required": [
            "date"
          ]
        }
      ],
      "allOf": [
        {
          "if": {
            "required": [
              "start"
            ]
          },
          "then": {
            "required": [
              "end"
            ],
            "not": {
              "required": [
                "observedAt"
              ]
            }
          }
        },
        {
          "if": {
            "required": [
              "end"
            ]
          },
          "then": {
            "required": [
              "start"
            ]
          }
        },
        {
          "if": {
            "required": [
              "observedAt"
            ]
          },
          "then": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "start"
                  ]
                },
                {
                  "required": [
                    "end"
                  ]
                }
              ]
            }
          }
        },
        {
          "if": {
            "required": [
              "date"
            ]
          },
          "then": {
            "properties": {
              "precision": {
                "const": "date_only"
              }
            },
            "not": {
              "anyOf": [
                {
                  "required": [
                    "observedAt"
                  ]
                },
                {
                  "required": [
                    "start"
                  ]
                },
                {
                  "required": [
                    "end"
                  ]
                }
              ]
            }
          }
        },
        {
          "if": {
            "required": [
              "precision"
            ],
            "properties": {
              "precision": {
                "const": "date_only"
              }
            }
          },
          "then": {
            "required": [
              "date"
            ]
          }
        }
      ]
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "enum": [
            "subject",
            "external_import",
            "unknown"
          ]
        },
        "name": {
          "type": "string"
        },
        "method": {
          "type": "string"
        }
      }
    },
    "participantReferences": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "contains": {
        "type": "object",
        "required": ["relationToRecorder"],
        "properties": { "relationToRecorder": { "const": "recorder" } }
      },
      "minContains": 1,
      "maxContains": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "reference",
          "relationToRecorder"
        ],
        "properties": {
          "reference": {
            "type": "string",
            "minLength": 1,
            "description": "Local pseudonym; do not put a name, handle, phone number, or contact detail here."
          },
          "relationToRecorder": {
            "enum": [
              "recorder",
              "partner",
              "family_member",
              "friend",
              "care_recipient",
              "professional",
              "other",
              "unknown"
            ]
          }
        }
      }
    },
    "perspective": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "account",
        "consentContext"
      ],
      "properties": {
        "account": {
          "type": "string",
          "minLength": 1,
          "description": "Brief account in the recorder's own words. Avoid explicit sexual detail and unnecessary third-party information."
        },
        "feltExperience": {
          "enum": [
            "connected",
            "distant",
            "positive",
            "mixed",
            "difficult",
            "uncertain",
            "not_reported"
          ]
        },
        "consentContext": {
          "enum": [
            "not_recorded",
            "recorder_reports_communication",
            "recorder_reports_uncertainty_or_concern",
            "not_applicable",
            "unknown"
          ]
        }
      }
    },
    "contextTags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "allOf": [
    {
      "if": {
        "required": [
          "eventKind"
        ],
        "properties": {
          "eventKind": {
            "const": "intimacy"
          }
        }
      },
      "then": {
        "properties": {
          "domain": {
            "const": "intimacy"
          },
          "participantReferences": {
            "minItems": 2
          },
          "limitations": {
            "contains": {
              "const": "This is the recorder's account; it does not establish another participant's consent, desire, experience, or health."
            }
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "eventKind"
        ],
        "properties": {
          "eventKind": {
            "not": {
              "const": "intimacy"
            }
          }
        }
      },
      "then": {
        "properties": {
          "domain": {
            "const": "relationship"
          }
        }
      }
    }
  ]
}
