{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://metheus.castalia.institute/schema/phase-annotation.schema.json",
  "title": "Metheus phase annotation",
  "description": "An optional evocative label attached to a time-bounded symbolic or lived phase. It does not replace canonical terminology, source provenance, or uncertainty.",
  "type": "object",
  "additionalProperties": false,
    "required": ["id", "subjectId", "layer", "phaseSystem", "canonicalPhase", "window", "basis", "interpretation", "method", "limitations"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "subjectId": { "type": "string", "minLength": 1 },
    "layer": { "enum": ["promethean", "epimethean"] },
    "phaseSystem": { "enum": ["human_design_transit", "astrological_transit", "menstrual_cycle", "pregnancy", "postpartum", "menopause", "development", "sleep_wake", "other"] },
    "canonicalPhase": { "type": "string", "minLength": 1 },
    "evocativeName": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "window": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start"],
      "properties": {
        "start": { "type": "string", "anyOf": [{ "format": "date" }, { "format": "date-time" }] },
        "end": { "type": "string", "anyOf": [{ "format": "date" }, { "format": "date-time" }] },
        "timeZone": { "type": "string", "description": "IANA time zone when the window is expressed in local civil time." }
      }
    },
    "basis": { "enum": ["reported", "observed", "derived", "clinically_assessed"] },
    "interpretation": { "enum": ["descriptive", "symbolic", "reflective"] },
    "basisRecordIds": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "sourceSystem": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "lineage": { "type": "string" },
        "version": { "type": "string" },
        "citation": { "type": "string", "format": "uri" }
      }
    },
    "method": { "type": "string", "minLength": 1 },
    "methodVersion": { "type": "string" },
    "uncertainty": { "type": "string" },
    "limitations": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "nameSource": { "enum": ["metheus_suggestion", "user_authored", "source_attributed"] }
  },
  "allOf": [
    {
      "if": { "properties": { "layer": { "const": "promethean" } } },
      "then": {
        "required": ["sourceSystem"],
        "properties": {
          "phaseSystem": { "enum": ["human_design_transit", "astrological_transit"] },
          "basis": { "const": "derived" },
          "interpretation": { "const": "symbolic" },
          "sourceSystem": { "required": ["name", "version"] }
        }
      }
    },
    {
      "if": { "properties": { "layer": { "const": "epimethean" } } },
      "then": {
        "properties": {
          "phaseSystem": { "enum": ["menstrual_cycle", "pregnancy", "postpartum", "menopause", "development", "sleep_wake", "other"] },
          "basis": { "enum": ["reported", "observed", "derived", "clinically_assessed"] },
          "interpretation": { "enum": ["descriptive", "reflective"] }
        }
      }
    }
  ]
}
