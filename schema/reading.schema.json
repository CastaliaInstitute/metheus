{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://metheus.castalia.institute/schema/reading.schema.json",
  "title": "Metheus reading",
  "description": "Draft v0.2 output contract for a sourced, revisable reflective reading. Not a clinical interpretation standard.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "subjectId", "version", "purpose", "question", "timeWindow", "claims", "generatedAt"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "subjectId": { "type": "string", "minLength": 1, "description": "Pseudonymous subject reference." },
    "version": { "type": "string", "minLength": 1 },
    "purpose": { "enum": ["symbolic_calculation", "personal_reflection", "rhythm_summary", "learning_support", "health_record_organization", "caregiver_coordination", "clinical_sharing", "other"] },
    "question": { "type": "string", "minLength": 1, "description": "The subject's chosen question or reflection focus. Keep it distinct from the consent purpose category." },
    "timeWindow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start", "end", "precision"],
      "properties": {
        "start": { "type": "string", "format": "date-time" },
        "end": { "type": "string", "format": "date-time" },
        "timeZone": { "type": "string" },
        "precision": { "enum": ["exact", "approximate", "date_only"] }
      }
    },
    "inputIds": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "referenceIds": {
      "type": "array",
      "description": "Selected non-personal correspondence and evidence-claim catalog entries. Subject-owned reflections belong in personal records. Catalog references are resolved separately and do not authorize access to subject records.",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "excludedDomains": {
      "type": "array",
      "description": "Domains the subject explicitly excludes from this reading. These are exact domain exclusions, not broad permission categories.",
      "items": {
        "enum": ["birth_chart_inputs", "circadian", "sleep", "feeding", "nutrition", "hydration", "activity", "behavior", "learning", "sensory_exposure", "supplement", "medication", "physiology", "hormone_assay", "symptom", "reproductive", "development", "relationship", "relationships", "intimacy", "environment", "life_event", "symbolic", "other"]
      },
      "uniqueItems": true
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["claimType", "text", "sourceIds", "support"],
        "properties": {
          "claimType": { "enum": ["observation", "estimate", "symbolic_prompt", "interpretive_question", "hypothesis", "boundary"] },
          "text": { "type": "string", "minLength": 1, "description": "One substantive sentence or atomic statement. Split text with different evidence bases, claim types, or material propositions into separate claim objects so each statement has its own provenance." },
          "sourceIds": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
          "phaseAnnotationIds": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true, "minItems": 1 },
          "correspondenceIds": { "type": "array", "items": { "type": "string" }, "uniqueItems": true, "minItems": 1 },
          "evidenceClaimIds": { "type": "array", "items": { "type": "string" }, "uniqueItems": true, "minItems": 1 },
          "support": {
            "type": "object",
            "additionalProperties": false,
            "required": ["confidence", "coverage"],
            "properties": {
              "confidence": { "enum": ["high", "moderate", "low", "not_applicable"] },
              "coverage": { "enum": ["adequate", "partial", "sparse", "unknown"] },
              "rationale": { "type": "string" },
              "alternatives": { "type": "array", "items": { "type": "string" } }
            }
          }
        },
        "allOf": [
          {
            "if": { "required": ["correspondenceIds"] },
            "then": { "properties": { "claimType": { "enum": ["symbolic_prompt", "interpretive_question"] } } }
          },
          {
            "if": { "required": ["evidenceClaimIds"] },
            "then": { "properties": { "claimType": { "enum": ["hypothesis", "boundary"] } } }
          },
          {
            "if": { "required": ["phaseAnnotationIds"] },
            "then": { "properties": { "claimType": { "enum": ["observation", "estimate", "symbolic_prompt", "interpretive_question", "hypothesis", "boundary"] } } }
          },
          {
            "if": {
              "required": ["phaseAnnotationIds", "claimType"],
              "properties": { "claimType": { "const": "hypothesis" } }
            },
            "then": { "properties": { "sourceIds": { "minItems": 1 } } }
          }
        ],
        "anyOf": [
          { "properties": { "sourceIds": { "minItems": 1 } } },
          { "required": ["phaseAnnotationIds"] },
          { "required": ["correspondenceIds"] },
          { "required": ["evidenceClaimIds"] }
        ]
      }
    },
    "reflectionOptions": {
      "type": "array",
      "description": "Optional choices for the subject to consider. These are not recommendations; the subject decides whether to choose, decline, or revise them.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "text", "basis", "sourceIds", "subjectStatus"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "kind": { "enum": ["learning_approach", "environmental_affordance", "observation_question", "reflection_question", "professional_consultation", "other"] },
          "text": { "type": "string", "minLength": 1 },
          "basis": { "enum": ["learner_goal", "task_demand", "access_need", "developmental_context", "symbolic_prompt", "evidence_reference", "multiple_non_symbolic_inputs", "unspecified"] },
          "sourceIds": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
          "subjectStatus": { "enum": ["not_reviewed", "chosen", "declined", "revised"] },
          "limitations": { "type": "array", "items": { "type": "string" } },
          "environmentalAffordance": {
            "type": "object",
            "additionalProperties": false,
            "required": ["deliveryMode", "intendedFunction", "roleFrame"],
            "properties": {
              "deliveryMode": { "enum": ["conversational_ai", "human_peer", "human_professional", "group_or_community", "physical_environment", "routine_or_practice", "digital_tool", "sensory_cue", "other"] },
              "intendedFunction": { "enum": ["communication_practice", "reflection", "problem_solving", "learning", "structure_or_routine", "access_support", "sensory_context", "connection", "other"] },
              "roleFrame": { "enum": ["tool_or_scaffold", "human_relationship", "environmental_condition", "other"] },
              "trialWindow": { "type": "string", "description": "Optional person-chosen trial duration or review point; not a prescribed treatment duration." },
              "userDefinedDescription": { "type": "string", "description": "Optional description of the support the person wants to try." },
              "aiSafeguards": {
                "type": "object",
                "additionalProperties": false,
                "required": ["identityTransparent", "privacyBoundariesDisclosed", "notHumanRelationshipSubstitute"],
                "properties": {
                  "identityTransparent": { "const": true },
                  "privacyBoundariesDisclosed": { "const": true },
                  "notHumanRelationshipSubstitute": { "const": true }
                }
              }
            }
          }
        },
        "allOf": [
          {
            "if": { "required": ["kind"], "properties": { "kind": { "const": "learning_approach" } } },
            "then": { "properties": { "basis": { "enum": ["learner_goal", "task_demand", "access_need", "developmental_context", "evidence_reference", "multiple_non_symbolic_inputs"] } } }
          },
          {
            "if": { "required": ["kind"], "properties": { "kind": { "const": "environmental_affordance" } } },
            "then": {
              "required": ["environmentalAffordance"],
              "properties": {
                "basis": { "enum": ["learner_goal", "task_demand", "access_need", "developmental_context", "evidence_reference", "multiple_non_symbolic_inputs"] },
                "sourceIds": { "minItems": 1 }
              }
            }
          },
          {
            "if": { "required": ["environmentalAffordance"] },
            "then": { "properties": { "kind": { "const": "environmental_affordance" } } }
          },
          {
            "if": { "required": ["environmentalAffordance"], "properties": { "environmentalAffordance": { "properties": { "deliveryMode": { "const": "conversational_ai" } }, "required": ["deliveryMode"] } } },
            "then": { "properties": { "environmentalAffordance": { "required": ["aiSafeguards"], "properties": { "roleFrame": { "const": "tool_or_scaffold" } } } } }
          },
          {
            "if": { "required": ["basis"], "properties": { "basis": { "const": "symbolic_prompt" } } },
            "then": { "properties": { "kind": { "const": "reflection_question" } } }
          }
        ]
      }
    },
    "synthesis": { "type": "string" },
    "reflectiveQuestion": { "type": "string" },
    "limitations": { "type": "array", "items": { "type": "string" } },
    "engine": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string" },
        "version": { "type": "string" },
        "symbolicSystems": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
      }
    },
    "generatedAt": { "type": "string", "format": "date-time" },
    "feedback": { "enum": ["not_reviewed", "resonates", "does_not_fit", "uncertain", "revised"] },
    "revisionOf": { "type": "string" }
  }
}
