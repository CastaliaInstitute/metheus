{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://metheus.castalia.institute/schema/rhythm-summary.schema.json",
  "title": "Metheus derived rhythm summary",
  "description": "A versioned, subject-scoped summary derived from selected observation/event records. Descriptive only; not a clinical or endocrine assessment.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "summaryId", "subjectId", "recordType", "schemaVersion", "summaryType", "summaryMeasure", "epistemicClass", "domain", "label", "methodVersion", "window", "inputRecordIds", "limitations"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "summaryId": { "type": "string", "minLength": 1 },
    "subjectId": { "type": "string", "minLength": 1 },
    "recordType": { "const": "rhythm_summary" },
    "schemaVersion": { "const": "0.1" },
    "summaryType": { "const": "derived_rhythm_summary" },
    "summaryMeasure": { "enum": ["bleeding_onset_intervals", "reported_cycle_day_one_intervals", "main_sleep", "meal_events", "caregiver_feeding_events", "meal_timing_relative_to_wake", "measurement_series"] },
    "epistemicClass": { "const": "derived" },
    "domain": { "enum": ["circadian", "sleep", "feeding", "nutrition", "hydration", "activity", "behavior", "learning", "sensory_exposure", "supplement", "medication", "physiology", "hormone_assay", "symptom", "reproductive", "development", "relationship", "intimacy", "environment", "life_event", "other"] },
    "label": { "type": "string", "minLength": 1 },
    "methodVersion": { "type": "string", "minLength": 1 },
    "revisionResolution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["strategy", "supersededRecordCount", "unresolvedPredecessorCount"],
      "properties": {
        "strategy": { "const": "latest_visible_successor" },
        "supersededRecordCount": { "type": "integer", "minimum": 0 },
        "unresolvedPredecessorCount": { "type": "integer", "minimum": 0 }
      }
    },
    "window": {
      "type": "object",
      "additionalProperties": false,
      "required": ["startDate", "endDate", "inclusiveDays"],
      "properties": {
        "startDate": { "type": "string", "format": "date" },
        "endDate": { "type": "string", "format": "date" },
        "inclusiveDays": { "type": "integer", "minimum": 1 }
      }
    },
    "inputRecordIds": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "supersedes": { "type": "string", "minLength": 1, "description": "Prior same-subject summary made obsolete by a recomputed summary." },
    "limitations": { "type": "array", "items": { "type": "string", "minLength": 1 }, "minItems": 1 },
    "nOnsetRecords": { "type": "integer", "minimum": 0 },
    "nDistinctOnsetDates": { "type": "integer", "minimum": 0 },
    "nCycleStartRecords": { "type": "integer", "minimum": 0 },
    "nDistinctCycleStartDates": { "type": "integer", "minimum": 0 },
    "boundaryCycleStartDate": { "type": ["string", "null"], "format": "date", "description": "Nearest self-reported cycle day-one date before the window, included only to describe the first in-window interval." },
    "boundaryCycleStartRecordIds": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "medianDayOneIntervalDays": { "type": ["number", "null"], "minimum": 0 },
    "medianAbsoluteDeviationDayOneIntervalDays": { "type": ["number", "null"], "minimum": 0 },
    "boundaryOnsetDate": { "type": ["string", "null"], "format": "date", "description": "Nearest explicitly logged onset before the selected window, when included to support its first in-window interval; not itself counted as an in-window onset." },
    "boundaryOnsetRecordIds": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true, "description": "Source IDs for the single preceding boundary date. These are included in inputRecordIds and require their own authorization." },
    "nIntervals": { "type": "integer", "minimum": 0 },
    "intervalsDays": { "type": "array", "items": { "type": "number", "minimum": 0 } },
    "medianGapDays": { "type": ["number", "null"], "minimum": 0 },
    "medianAbsoluteDeviationDays": { "type": ["number", "null"], "minimum": 0 },
    "dateOnlyRecordCount": { "type": "integer", "minimum": 0 },
    "timedRecordCount": { "type": "integer", "minimum": 0 },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "daysWithAtLeastOneRecord": { "type": "integer", "minimum": 0 },
        "daysWithEvents": { "type": "integer", "minimum": 0 },
        "wakeDatesWithCompleteWakeToWakeInterval": { "type": "integer", "minimum": 0 },
        "calendarDaysInWindow": { "type": "integer", "minimum": 1 },
        "fractionOfDaysWithARecord": { "type": "number", "minimum": 0, "maximum": 1 },
        "fractionOfDaysWithEvents": { "type": "number", "minimum": 0, "maximum": 1 },
        "fractionOfDaysWithCompleteInterval": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "medianLoggedDurationMinutes": { "type": ["number", "null"], "minimum": 0 },
    "medianLoggedStartClockTime": { "type": ["string", "null"], "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$" },
    "medianLoggedMidpointClockTime": { "type": ["string", "null"], "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$" },
    "medianAbsoluteMidpointDeviationMinutes": { "type": ["number", "null"], "minimum": 0 },
    "clockTimesComparable": { "type": "boolean" },
    "clockTimeContextCount": { "type": "integer", "minimum": 0 },
    "clockTimeContexts": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "nEvents": { "type": "integer", "minimum": 0 },
    "medianEventsPerObservedDay": { "type": ["number", "null"], "minimum": 0 },
    "medianEventClockTime": { "type": ["string", "null"], "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$" },
    "medianAbsoluteEventTimeDeviationMinutes": { "type": ["number", "null"], "minimum": 0 },
    "medianRecordedWithinDaySpanMinutes": { "type": ["number", "null"], "minimum": 0 },
    "timeReference": { "const": "elapsed_minutes_from_explicit_wake_event" },
    "nWakeToWakeIntervals": { "type": "integer", "minimum": 0 },
    "nCandidateWakeToWakeIntervals": { "type": "integer", "minimum": 0 },
    "nIntervalsExcludedForGap": { "type": "integer", "minimum": 0 },
    "maximumIntervalHours": { "type": "number", "exclusiveMinimum": 0 },
    "nIntervalsWithLoggedMeals": { "type": "integer", "minimum": 0 },
    "nLoggedMeals": { "type": "integer", "minimum": 0 },
    "medianFirstLoggedMealMinutesAfterWake": { "type": ["number", "null"], "minimum": 0 },
    "medianLoggedMealMinutesAfterWake": { "type": ["number", "null"], "minimum": 0 },
    "measurementSeries": {
      "type": "object",
      "additionalProperties": false,
      "required": ["analyteOrSignal", "unit", "epistemicClass", "sourceKind", "sourceName", "sourceMethod", "sourceVersion", "methodDetails", "specimen", "sensorLocation", "deviceOrAssay", "deviceModel", "algorithmVersion", "collectionConditions"],
      "properties": {
        "analyteOrSignal": { "type": "string", "minLength": 1 },
        "unit": { "type": "string", "minLength": 1 },
        "epistemicClass": { "enum": ["measured", "derived", "imported"] },
        "sourceKind": { "type": "string", "minLength": 1 },
        "sourceName": { "type": "string", "minLength": 1 },
        "sourceMethod": { "type": "string", "minLength": 1 },
        "sourceVersion": { "type": "string", "minLength": 1 },
        "methodDetails": { "type": "string", "minLength": 1 },
        "specimen": { "type": "string", "minLength": 1 },
        "sensorLocation": { "type": "string", "minLength": 1 },
        "deviceOrAssay": { "type": "string", "minLength": 1 },
        "deviceModel": { "type": "string", "minLength": 1 },
        "algorithmVersion": { "type": "string", "minLength": 1 },
        "collectionConditions": { "type": "string", "minLength": 1 }
      }
    },
    "bucketDays": { "type": "integer", "minimum": 1, "maximum": 366 },
    "timeBuckets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["startDate", "endDate", "inclusiveDays", "inputRecordIds", "nMeasurements", "nDistinctMeasurementDates", "medianValue", "medianAbsoluteDeviationValue", "minimumValue", "maximumValue", "recordsWithQualityFlags", "qualityFlags", "uncertaintyMetadata", "daysWithAtLeastOneRecord", "fractionOfDaysWithARecord"],
        "properties": {
          "startDate": { "type": "string", "format": "date" },
          "endDate": { "type": "string", "format": "date" },
          "inclusiveDays": { "type": "integer", "minimum": 1 },
          "inputRecordIds": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
          "nMeasurements": { "type": "integer", "minimum": 0 },
          "nDistinctMeasurementDates": { "type": "integer", "minimum": 0 },
          "medianValue": { "type": ["number", "null"] },
          "medianAbsoluteDeviationValue": { "type": ["number", "null"], "minimum": 0 },
          "minimumValue": { "type": ["number", "null"] },
          "maximumValue": { "type": ["number", "null"] },
          "recordsWithQualityFlags": { "type": "integer", "minimum": 0 },
          "qualityFlags": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
          "uncertaintyMetadata": { "$ref": "#/$defs/uncertaintyMetadata" },
          "daysWithAtLeastOneRecord": { "type": "integer", "minimum": 0 },
          "fractionOfDaysWithARecord": { "type": "number", "minimum": 0, "maximum": 1 }
        },
        "allOf": [
          { "if": { "properties": { "nMeasurements": { "const": 0 } }, "required": ["nMeasurements"] }, "then": { "properties": { "medianValue": { "type": "null" }, "medianAbsoluteDeviationValue": { "type": "null" }, "minimumValue": { "type": "null" }, "maximumValue": { "type": "null" } } } },
          { "if": { "properties": { "nMeasurements": { "minimum": 1 } }, "required": ["nMeasurements"] }, "then": { "properties": { "medianValue": { "type": "number" }, "medianAbsoluteDeviationValue": { "type": "number" }, "minimumValue": { "type": "number" }, "maximumValue": { "type": "number" } } } }
        ]
      }
    },
    "nMeasurements": { "type": "integer", "minimum": 0 },
    "nDistinctMeasurementDates": { "type": "integer", "minimum": 0 },
    "medianNumericValue": { "type": ["number", "null"] },
    "medianAbsoluteDeviationValue": { "type": ["number", "null"], "minimum": 0 },
    "minimumValue": { "type": ["number", "null"] },
    "maximumValue": { "type": ["number", "null"] },
    "recordsWithQualityFlags": { "type": "integer", "minimum": 0 },
    "qualityFlags": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "uncertaintyMetadata": { "$ref": "#/$defs/uncertaintyMetadata" }
  },
  "allOf": [
    { "if": { "required": ["summaryMeasure"], "properties": { "summaryMeasure": { "const": "bleeding_onset_intervals" } } }, "then": { "properties": { "domain": { "const": "reproductive" }, "methodVersion": { "const": "metheus-bleeding-onset-gap/0.3.0" } }, "required": ["nIntervals", "nOnsetRecords", "nDistinctOnsetDates", "boundaryOnsetDate", "boundaryOnsetRecordIds", "intervalsDays", "medianGapDays", "medianAbsoluteDeviationDays", "dateOnlyRecordCount", "timedRecordCount"] } },
    { "if": { "required": ["summaryMeasure", "boundaryOnsetDate"], "properties": { "summaryMeasure": { "const": "bleeding_onset_intervals" }, "boundaryOnsetDate": { "type": "null" } } }, "then": { "properties": { "boundaryOnsetRecordIds": { "maxItems": 0 } } } },
    { "if": { "required": ["summaryMeasure", "boundaryOnsetDate"], "properties": { "summaryMeasure": { "const": "bleeding_onset_intervals" }, "boundaryOnsetDate": { "type": "string" } } }, "then": { "properties": { "boundaryOnsetRecordIds": { "minItems": 1 } } } },
    { "if": { "required": ["summaryMeasure"], "properties": { "summaryMeasure": { "const": "reported_cycle_day_one_intervals" } } }, "then": { "properties": { "domain": { "const": "reproductive" }, "methodVersion": { "const": "metheus-reported-cycle-day-one/0.1.0" } }, "required": ["nCycleStartRecords", "nDistinctCycleStartDates", "boundaryCycleStartDate", "boundaryCycleStartRecordIds", "nIntervals", "intervalsDays", "medianDayOneIntervalDays", "medianAbsoluteDeviationDayOneIntervalDays", "dateOnlyRecordCount", "timedRecordCount"] } },
    { "if": { "required": ["summaryMeasure", "boundaryCycleStartDate"], "properties": { "summaryMeasure": { "const": "reported_cycle_day_one_intervals" }, "boundaryCycleStartDate": { "type": "null" } } }, "then": { "properties": { "boundaryCycleStartRecordIds": { "maxItems": 0 } } } },
    { "if": { "required": ["summaryMeasure", "boundaryCycleStartDate"], "properties": { "summaryMeasure": { "const": "reported_cycle_day_one_intervals" }, "boundaryCycleStartDate": { "type": "string" } } }, "then": { "properties": { "boundaryCycleStartRecordIds": { "minItems": 1 } } } },
    { "if": { "required": ["summaryMeasure"], "properties": { "summaryMeasure": { "const": "main_sleep" } } }, "then": { "properties": { "domain": { "const": "sleep" }, "methodVersion": { "const": "metheus-rhythm-summary/0.2.0" } }, "required": ["nIntervals", "coverage", "medianLoggedDurationMinutes", "medianLoggedStartClockTime", "medianLoggedMidpointClockTime", "medianAbsoluteMidpointDeviationMinutes", "clockTimesComparable", "clockTimeContextCount", "clockTimeContexts"] } },
    { "if": { "required": ["summaryMeasure"], "properties": { "summaryMeasure": { "const": "meal_events" } } }, "then": { "properties": { "domain": { "const": "nutrition" }, "methodVersion": { "const": "metheus-feeding-summary/0.3.0" } }, "required": ["coverage", "nEvents", "daysWithEvents", "medianEventsPerObservedDay", "medianEventClockTime", "medianAbsoluteEventTimeDeviationMinutes", "medianRecordedWithinDaySpanMinutes", "clockTimesComparable", "clockTimeContextCount", "clockTimeContexts"] } },
    { "if": { "required": ["summaryMeasure"], "properties": { "summaryMeasure": { "const": "caregiver_feeding_events" } } }, "then": { "properties": { "domain": { "const": "feeding" }, "methodVersion": { "const": "metheus-feeding-summary/0.3.0" } }, "required": ["coverage", "nEvents", "daysWithEvents", "medianEventsPerObservedDay", "medianEventClockTime", "medianAbsoluteEventTimeDeviationMinutes", "medianRecordedWithinDaySpanMinutes", "clockTimesComparable", "clockTimeContextCount", "clockTimeContexts"] } },
    { "if": { "required": ["summaryMeasure"], "properties": { "summaryMeasure": { "const": "meal_timing_relative_to_wake" } } }, "then": { "properties": { "domain": { "const": "nutrition" }, "methodVersion": { "const": "metheus-wake-relative-meal/0.2.0" }, "timeReference": { "const": "elapsed_minutes_from_explicit_wake_event" } }, "required": ["nWakeToWakeIntervals", "nCandidateWakeToWakeIntervals", "nIntervalsExcludedForGap", "maximumIntervalHours", "nIntervalsWithLoggedMeals", "nLoggedMeals", "coverage", "medianFirstLoggedMealMinutesAfterWake", "medianLoggedMealMinutesAfterWake"] } },
    { "if": { "required": ["summaryMeasure"], "properties": { "summaryMeasure": { "const": "measurement_series" } } }, "then": { "properties": { "methodVersion": { "const": "metheus-numeric-measurement-series/0.3.0" } }, "required": ["measurementSeries", "bucketDays", "timeBuckets", "nMeasurements", "nDistinctMeasurementDates", "medianNumericValue", "medianAbsoluteDeviationValue", "minimumValue", "maximumValue", "recordsWithQualityFlags", "qualityFlags", "uncertaintyMetadata", "coverage"] } }
  ],
  "$defs": {
    "uncertaintyMetadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["recordsWithUncertaintyObject", "levelCounts"],
      "properties": {
        "recordsWithUncertaintyObject": { "type": "integer", "minimum": 0 },
        "levelCounts": {
          "type": "object",
          "additionalProperties": false,
          "required": ["low", "moderate", "high", "unknown", "not_reported"],
          "properties": {
            "low": { "type": "integer", "minimum": 0 },
            "moderate": { "type": "integer", "minimum": 0 },
            "high": { "type": "integer", "minimum": 0 },
            "unknown": { "type": "integer", "minimum": 0 },
            "not_reported": { "type": "integer", "minimum": 0 }
          }
        }
      }
    }
  }
}
